#!/bin/sh
# bbx-run-static — THE PRE-COMMIT GATE CHAIN of a consumer project. One
# command, every gate that does not need an instrument (an emulator, a
# simulator, a driver, an external tool).
#
# Lifted from bbh bin/bbh-run-static (S1, 2026-09-09), whose lineage is
# VampireSaved's tests/run_all_static.sh (14z-94, GitHub #30 there). WHY IT
# EXISTS: a suite nobody invokes cannot halt forward work. That project had no
# CI and 101 of its 130 gates had no shell caller; one of them sat RED for 11
# days while the law cited it as a guarantee. Automated here is the
# instrument-free set — the gates cheap enough to run before every commit.
#
# THREE VERDICTS, AND SKIP IS NOT PASS. A gate whose inputs are absent prints
# `SKIP: <reason>` and exits 0. Counting that as a pass is how a clean
# checkout reports green while asserting nothing, so SKIP is counted and
# printed separately, and `--strict` makes it fatal. The classifier is
# lib/sh/classify.sh, one copy for every runner.
#
# ONE ADDITION over bbh (ruled R10, docs/controls.md): under [controls]
# enforce = true, every gate's MUST-FIRE declarations are read from its
# header and compared with the CONTROL FIRED lines in its output; a declared
# control that did not fire, or a firing nobody declared, is RED. Off, the
# output is bbh's byte for byte (fidelity F13); BBX's own config turns it on.
#
# Usage:
#   bbx-run-static [--config config.toml]     portable tier only (no inputs)
#   <NEEDS_ENV>=... bbx-run-static            portable + static tiers
#   ... --strict                              SKIP is a failure too
#   ... --list                                print the registry and exit
#   ... --tier portable|static                one tier only
#   ... --log DIR                              keep the run: results.tsv, <gate>.log, controls.txt,
#                                              run.txt (subject HEAD, porcelain, platform) — the
#                                              readout's input (bbx readout DIR); prints nothing extra
#
# The config names the gates dir and the two registries ([registries]
# portable / static), and `static_needs_env` — the variable whose presence
# enables the static tier. A gate that is instrument-free and in NEITHER
# registry is reported as UNREGISTERED — that check is the actual anti-orphan
# mechanism (lib/py/bbx/tier.py), and without it this script would simply
# become a new, smaller thing to forget to update.
set -eu
BBX_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBX_HOME
. "$BBX_HOME/lib/sh/config.sh"
. "$BBX_HOME/lib/sh/classify.sh"
. "$BBX_HOME/lib/sh/registry.sh"

CONFIG=""; STRICT=0; TIER=all; LIST=0; LOG=""
while [ $# -gt 0 ]; do
    case "$1" in
    --config) shift; CONFIG="${1:?--config needs a file}" ;;
    --strict) STRICT=1 ;;
    --list)   LIST=1 ;;
    --tier)   shift; TIER="${1:?--tier needs portable|static|all}" ;;
    --log)    shift; LOG="${1:?--log needs a dir}" ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    *) echo "unknown argument '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

bbx_config_init "$CONFIG"
bbx_classify_env
GATES_DIR="$(bbx_cfg project.gates_dir)"
REG_PORTABLE="$(bbx_cfg registries.portable)"
REG_STATIC="$(bbx_cfg registries.static)"
NEEDS_ENV="$(bbx_cfg registries.static_needs_env "")"
WORD="$(bbx_cfg project.instrument_word)"
ENFORCE="$(bbx_cfg controls.enforce)"

# The input variable must be ABSOLUTE for the gates: a gate that resolves it
# from a DIFFERENT working directory than the caller's (a symlink into it from
# a temp dir, an overlay it cd's into) dangles on a relative path. Measured in
# the lineage: 2 of 3 "failures" that looked like a broken suite. Canonicalise
# at the entrance, BEFORE the cd below, so the documented pre-commit command
# is robust to how the caller spells it.
if [ -n "$NEEDS_ENV" ]; then
    eval "_needs_val=\${$NEEDS_ENV:-}"
    if [ -n "$_needs_val" ]; then
        _abs="$(CDPATH= cd "$_needs_val" && pwd)" || {
            echo "$NEEDS_ENV '$_needs_val' does not resolve from $(pwd)" >&2; exit 2; }
        eval "$NEEDS_ENV=\"\$_abs\""
        export "$NEEDS_ENV"
    fi
fi
cd "$BBX_ROOT"

PORTABLE="$(bbx_read_reg "$REG_PORTABLE")"
STATIC="$(bbx_read_reg "$REG_STATIC")"

if [ "$LIST" = 1 ]; then
    echo "portable ($(bbx_count "$PORTABLE")):"
    printf '%s\n' "$PORTABLE" | awk 'NF{print "  " $0}'
    echo "static ($(bbx_count "$STATIC")):"
    printf '%s\n' "$STATIC" | awk 'NF{print "  " $0}'
    exit 0
fi

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT INT TERM
# --log: the run kept on disk, keyed by (subject version, start time) — BBX-29. Nothing printed changes.
RUN_START="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ -n "$LOG" ]; then
    mkdir -p "$LOG" && LOG="$(CDPATH= cd "$LOG" && pwd)" || { echo "cannot create --log $LOG" >&2; exit 2; }
    printf 'gate\ttier\tverdict\tseconds\texit\tdetail\n' > "$LOG/results.tsv"
fi
n_pass=0; n_skip=0; n_fail=0; n_miss=0
failed=""; skipped=""; ran=""

# WORKING-TREE SNAPSHOT. This is the PRE-COMMIT command, so it must not leave
# the tree dirty — and in the lineage it did on the first full run: gates
# built into tracked paths rather than a temp dir. A pre-commit check whose
# own side effect is a diff will get its output ignored, so the run reports
# it. Reported, not failed: the gates are correct, their output location is
# not, and that is its own fix.
tree_before=""
if git rev-parse --git-dir >/dev/null 2>&1; then
    tree_before="$(git status --porcelain -- . 2>/dev/null | grep -v '^??' || true)"
fi

run_tier() {  # run_tier <label> <names>
    _label="$1"; _names="$2"
    [ -n "$_names" ] || return 0
    echo "== $_label tier =="
    for g in $_names; do
        if [ ! -x "$GATES_DIR/$g.sh" ]; then
            printf '  %-34s %s\n' "$g" "MISSING (registered but not executable)"
            n_miss=$((n_miss + 1)); failed="$failed $g(missing)"
            [ -z "$LOG" ] || printf '%s\t%s\tMISSING\t0\t-\tregistered but not executable\n' "$g" "$_label" >> "$LOG/results.tsv"
            continue
        fi
        _t0=$(date +%s)
        # </dev/null: a gate that reads stdin otherwise swallows the rest of
        # this loop's input. Paid for once — a 32-entry run became 28 silently.
        "$GATES_DIR/$g.sh" </dev/null > "$WORK/$g.out" 2>&1 && _st=0 || _st=$?
        _t1=$(date +%s)
        _dur=$((_t1 - _t0))
        ran="$ran $g"
        bbx_classify "$_st" "$WORK/$g.out" 58
        if [ -n "$LOG" ]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$g" "$_label" "$BBX_VERDICT" "$_dur" "$_st" "$BBX_DETAIL" >> "$LOG/results.tsv"
            cp "$WORK/$g.out" "$LOG/$g.log"
        fi
        case "$BBX_VERDICT" in
        TIMEOUT)
            printf '  %-34s TIMEOUT %3ss  (exit %s)\n' "$g" "$_dur" "$_st"
            n_fail=$((n_fail + 1)); failed="$failed $g" ;;
        FAIL)
            if [ "$_st" != 0 ]; then
                printf '  %-34s FAIL  %3ss  (exit %s)\n' "$g" "$_dur" "$_st"
            else
                printf '  %-34s FAIL  %3ss  (exit 0 after a shell error)\n' "$g" "$_dur"
            fi
            # FAIL_TAIL: how much of a failing gate's output to show (default
            # from the config; a red read remotely needs the section that
            # failed, not the last four lines of its controls).
            tail -"${FAIL_TAIL:-${BBX_CLASSIFY_FAIL_TAIL:-4}}" "$WORK/$g.out" | sed 's/^/        | /'
            n_fail=$((n_fail + 1)); failed="$failed $g" ;;
        SKIP)
            printf '  %-34s SKIP  %3ss  %s\n' "$g" "$_dur" "$BBX_DETAIL"
            n_skip=$((n_skip + 1)); skipped="$skipped $g" ;;
        *)
            printf '  %-34s PASS  %3ss\n' "$g" "$_dur"
            n_pass=$((n_pass + 1)) ;;
        esac
    done
}

static_enabled() {
    [ -z "$NEEDS_ENV" ] && return 0
    eval "_v=\${$NEEDS_ENV:-}"
    [ -n "$_v" ]
}

case "$TIER" in
portable) run_tier portable "$PORTABLE" ;;
static)   run_tier static   "$STATIC" ;;
all)
    run_tier portable "$PORTABLE"
    if static_enabled; then
        run_tier static "$STATIC"
    else
        echo "== static tier =="
        echo "  NOT RUN: $NEEDS_ENV is unset. These gates read the reference set or"
        echo "           a build dir. Set $NEEDS_ENV to include them."
        n_skip=$((n_skip + $(bbx_count "$STATIC")))
        skipped="$skipped <static-tier:$NEEDS_ENV-unset>"
    fi ;;
*) echo "bad --tier '$TIER'" >&2; exit 2 ;;
esac

echo
echo "== registry coverage (the anti-orphan check) =="
python3 -m bbx.tier "$BBX_CONFIG" --unregistered

# THE CONTROLS BLOCK (R10). Declared in each gate's header, read from its
# output; a control that did not fire refuses the verdict (BBX-6).
n_ctrl_red=0
if [ "$ENFORCE" = true ] && [ -n "$ran" ]; then
    echo
    echo "== controls (declared MUST-FIRE vs CONTROL FIRED) =="
    # shellcheck disable=SC2086
    python3 -m bbx.controls report "$GATES_DIR" "$WORK" $ran > "$WORK/controls.txt" && _cst=0 || _cst=$?
    [ -z "$LOG" ] || cp "$WORK/controls.txt" "$LOG/controls.txt"
    sed 's/^/  /' "$WORK/controls.txt"
    n_ctrl_red="$(grep -c 'verdict=RED' "$WORK/controls.txt" || true)"
    _decl="$(awk '{for(i=1;i<=NF;i++) if($i ~ /^declared=/){split($i,a,"="); s+=a[2]}} END{print s+0}' "$WORK/controls.txt")"
    _fired="$(awk '{for(i=1;i<=NF;i++) if($i ~ /^fired=/){split($i,a,"="); s+=a[2]}} END{print s+0}' "$WORK/controls.txt")"
    _undecl="$(grep -c 'verdict=UNDECLARED' "$WORK/controls.txt" || true)"
    # under enforcement a gate with no declaration is red too: silence is not "asserts nothing"
    n_ctrl_red=$((n_ctrl_red + _undecl))
    echo "  controls fired $_fired / declared $_decl; gates with no declaration: $_undecl; red: $n_ctrl_red"
fi

echo
echo "== working tree (a pre-commit command must not dirty it) =="
if [ -z "$tree_before" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "  note: not a git checkout — not checked"
else
    tree_after="$(git status --porcelain -- . 2>/dev/null | grep -v '^??' || true)"
    if [ "$tree_before" = "$tree_after" ]; then
        echo "  ok: no tracked file changed during the run"
    else
        # Diff via files: `grep -vxF "$multiline"` treats the string as a
        # pattern LIST and a blank line in it matches everything.
        printf '%s\n' "$tree_before" | awk 'NF' > "$WORK/tree_before.txt"
        printf '%s\n' "$tree_after"  | awk 'NF' > "$WORK/tree_after.txt"
        echo "  DIRTIED by the run — these gates write into TRACKED paths"
        echo "  instead of a temp dir; restore with 'git checkout --' on them:"
        diff "$WORK/tree_before.txt" "$WORK/tree_after.txt" \
            | grep '^[<>]' | sed 's/^/      /' | head -12
        echo "      (before: $(wc -l < "$WORK/tree_before.txt" | tr -d ' ') entries," \
             "after: $(wc -l < "$WORK/tree_after.txt" | tr -d ' '))"
    fi
fi

# NOTE-class numbers: a measurement a gate REPORTS but never gates on. A
# verdict is per GATE; a NOTE is per NUMBER, and one gate can report several,
# so this is deliberately NOT a fifth verdict in lib/sh/classify.sh - that
# would have to reach every runner and its ground truth. The convention: a
# gate prints `NOTE: <key> <value>` at column 0, exits 0 with its usual PASS,
# and this block surfaces it. A number moving the wrong way is the signal.
echo
echo "== NOTE-class numbers (reported, never fatal) =="
_notes=0
for _f in "$WORK"/*.out; do
    [ -f "$_f" ] || continue
    _g="$(basename "$_f" .out)"
    while IFS= read -r _line; do
        # an EMPTY command substitution still feeds `read` one blank line
        [ -n "$_line" ] || continue
        printf '  %-34s %s\n' "$_g" "${_line#NOTE: }"
        _notes=$((_notes + 1))
    done <<EOF
$(grep '^NOTE: ' "$_f" 2>/dev/null || true)
EOF
done
[ "$_notes" = 0 ] && echo "  (none)"

echo
echo "======================================================================"
printf 'PASS %-4s  SKIP %-4s  FAIL %-4s  MISSING %s\n' \
    "$n_pass" "$n_skip" "$n_fail" "$n_miss"
[ -n "$skipped" ] && echo "skipped:$skipped"
[ -n "$failed" ]  && echo "failed: $failed"

rc=0
[ "$n_fail" = 0 ] && [ "$n_miss" = 0 ] || rc=1
if [ "$STRICT" = 1 ] && [ "$n_skip" != 0 ]; then
    echo "--strict: SKIP counts as failure (a skipped gate asserts NOTHING)"
    rc=1
fi
if [ "$n_ctrl_red" != 0 ]; then
    echo "controls: $n_ctrl_red gate(s) with a dead or undeclared control (a dead control refuses a verdict)"
    rc=1
fi
[ "$rc" = 0 ] && echo "GREEN — every registered $WORD-free gate passed." \
              || echo "NOT GREEN — see above. Rule 6: fixing this is the only task."
if [ -n "$LOG" ]; then
    _root="$(pwd)"; _head="$(git rev-parse --short HEAD 2>/dev/null || echo '-')"
    _porc="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    _tree=not-checked
    if git rev-parse --git-dir >/dev/null 2>&1; then
        [ "$tree_before" = "${tree_after:-$tree_before}" ] && _tree=unchanged || _tree=dirtied
    fi
    {
        echo "config=$BBX_CONFIG"; echo "root=$_root"; echo "kind=$(bbx_cfg project.kind "-")"; echo "gates_dir=$GATES_DIR"
        echo "head=$_head"; echo "porcelain=$_porc"; echo "started=$RUN_START"; echo "platform=$(uname -sm)"
        echo "bbx_home=$BBX_HOME"; echo "bbx_head=$(git -C "$BBX_HOME" rev-parse --short HEAD 2>/dev/null || echo '-')"
        echo "tier=$TIER"; echo "strict=$STRICT"; echo "controls_enforced=$ENFORCE"
        echo "pass=$n_pass"; echo "skip=$n_skip"; echo "fail=$n_fail"; echo "missing=$n_miss"; echo "controls_red=$n_ctrl_red"
        echo "tree=$_tree"; echo "verdict=$([ "$rc" = 0 ] && echo GREEN || echo 'NOT GREEN')"
        echo "rebaseline=$(grep -m1 '^- ' "$BBX_HOME/docs/rebaselines.md" 2>/dev/null | cut -c3- || true)"
    } > "$LOG/run.txt"
fi
exit $rc
