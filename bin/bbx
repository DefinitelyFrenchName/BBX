#!/bin/sh
# bbx — Black Box harness eXpanded: the one entry point.
#
# Usage:
#   bbx run-static [args]         the pre-commit chain            (bin/bbx-run-static)
#   bbx run-suite [args]          the suite: identity -> expectation set, every scenario twice, dispatch by kind (bin/bbx-run-suite; S2)
#   bbx classify <exit> <log>     one verdict                      (bin/bbx-classify)
#   bbx tier <config> [--list|--unregistered]                      (lib/py/bbx/tier.py)
#   bbx config <config> get <section.key> [--default V] | dump | root | kind
#   bbx controls declared <gate.sh> | report <gates_dir> <logs_dir> <name>...   (lib/py/bbx/controls.py)
#   bbx recount <census.md> [--only A1,A2] [--root DIR]            (lib/py/bbx/recount.py)
#   bbx readout <run-dir> [--against <run-dir>]                   the one screen (lib/py/bbx/readout.py)
#   bbx compare <class-tool> [args]   a comparator directly: flicker | window | composite | diverge | propose (temporal); exact | set | schema (S3)
#   bbx selftest [--strict]       BBX's own gate chain, through its own runner (R14)
#
# Every subcommand finds the harness from THIS file's location, so the
# harness can live anywhere; the consumer is found from --config / $BBX_CONFIG
# / ./bbx.toml / ./bbh.toml. Slice S1 (2026-09-09): the kernel. Lifted shape
# from bbh bin/bbh.
set -eu
BBX_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBX_HOME
[ $# -ge 1 ] || { sed -n '2,17p' "$0"; exit 2; }
cmd="$1"; shift
PYTHONPATH="$BBX_HOME/lib/py${PYTHONPATH:+:$PYTHONPATH}"; export PYTHONPATH
case "$cmd" in
run-static)   exec "$BBX_HOME/bin/bbx-run-static" "$@" ;;
run-suite)    exec "$BBX_HOME/bin/bbx-run-suite" "$@" ;;
classify)     exec "$BBX_HOME/bin/bbx-classify" "$@" ;;
tier)         exec python3 -m bbx.tier "$@" ;;
config)       exec python3 -m bbx.config "$@" ;;
controls)     exec python3 -m bbx.controls "$@" ;;
recount)      exec python3 -m bbx.recount "$@" ;;
readout)      exec python3 -m bbx.readout "$@" ;;
compare)      _t="${1:?bbx compare <flicker|window|composite|diverge|propose> ...}"; shift; case "$_t" in flicker|window|composite|exact|set|schema) exec python3 -m "bbx.compare_$_t" "$@" ;; diverge) exec python3 -m bbx.check_diverge "$@" ;; propose) exec python3 -m bbx.propose_temporal "$@" ;; *) echo "bbx compare: unknown class tool '$_t'" >&2; exit 2 ;; esac ;;
selftest)     cd "$BBX_HOME" && exec "$BBX_HOME/bin/bbx-run-static" --config "$BBX_HOME/bbx.toml" "$@" ;;
-h|--help|help) sed -n '2,17p' "$0"; exit 0 ;;
*) echo "bbx: unknown command '$cmd' (try bbx help)" >&2; exit 2 ;;
esac
