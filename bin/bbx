#!/bin/sh
# bbx — Black Box harness eXpanded: the one entry point.
#
# Usage:
#   bbx run-static [args]         the pre-commit chain            (bin/bbx-run-static)
#   bbx run-suite [args]          the suite: identity -> expectation set, every scenario twice, dispatch by kind (bin/bbx-run-suite; S2)
#   bbx classify <exit> <log>     one verdict                      (bin/bbx-classify)
#   bbx tier <config> [--list|--unregistered|--complete]           (lib/py/bbx/tier.py)
#   bbx config <config> get <section.key> [--default V] | dump | root | kind
#   bbx controls declared <gate.sh> | report [--skipped g1,g2] <gates_dir> <logs_dir> <name>...   (lib/py/bbx/controls.py)
#   bbx recount <census.md> [--only A1,A2] [--root DIR]            (lib/py/bbx/recount.py)
#   bbx readout <run-dir> [--against <run-dir>]                   the one screen (lib/py/bbx/readout.py)
#   bbx compare <class-tool> [args]   a comparator directly: flicker | window | composite | diverge | propose (temporal); exact | set | schema (S3); band (S4)
#   bbx selftest [--strict]       BBX's own gate chain, through its own runner (R14)
#   bbx file-census --self|--root DIR --out DIR [--document P] [--check] [--frozen P] [--freeze]
#                                 which harness file each gate EXECUTES, by the gate's kind (lib/py/bbx/file_census.py; R39)
#   bbx check-skills [--config C] [--root DIR] [-v] [--no-selftest]   a consumer's skills locked to the docs they distil (lib/py/bbx/checkskills.py; S5)
#   bbx skill-guide [--config C] [--root DIR] [--check] [--prefix P]  the GENERATED GUIDE.md beside a SKILL.md (lib/py/bbx/gen_skill_guide.py; S5)
#   bbx reanchors [--root DIR] [--rules P] [--ledger P] [--through N] [--against T]   which rules the incident ledger re-anchors (lib/py/bbx/reanchors.py; S5, R53)
#   bbx skill-gen [--config C] [--root DIR] [--check] [--prefix P]    the GENERATED SKILL.md and its anchor page (lib/py/bbx/gen_skill.py; S5, R51, R52)
#   bbx defaults --check [--root DIR] [--register P]    the defaults register both ways against the code, and every default's reader (lib/py/bbx/defaults.py; S6, R61, R66)
#   bbx documents --check [--root DIR] [--register P]   every tracked page's shape, twin and route (lib/py/bbx/documents.py; S6, R62)
#   bbx demand-after-trap <gates-dir> [--lib d] [--skip name]   no demand after an EXIT trap (lib/py/bbx/demand_after_trap.py; S6, R63)
#   bbx gate-index [--config C] [--root DIR] [--check|--stdout]  the GENERATED gate index (lib/py/bbx/gen_gate_index.py; S6, R63, R68)
#
# Every subcommand finds the harness from THIS file's location, so the
# harness can live anywhere; the consumer is found from --config / $BBX_CONFIG
# / ./bbx.toml / ./bbh.toml. Slice S1 (2026-09-09): the kernel. Lifted shape
# from bbh bin/bbh.
set -eu
BBX_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBX_HOME
[ $# -ge 1 ] || { sed -n '2,27p' "$0"; exit 2; }
cmd="$1"; shift
PYTHONPATH="$BBX_HOME/lib/py${PYTHONPATH:+:$PYTHONPATH}"; export PYTHONPATH
case "$cmd" in
run-static)   exec "$BBX_HOME/bin/bbx-run-static" "$@" ;;
run-suite)    exec "$BBX_HOME/bin/bbx-run-suite" "$@" ;;
classify)     exec "$BBX_HOME/bin/bbx-classify" "$@" ;;
tier)         exec python3 -m bbx.tier "$@" ;;
config)       exec python3 -m bbx.config "$@" ;;
controls)     exec python3 -m bbx.controls "$@" ;;
recount)      exec python3 -m bbx.recount "$@" ;;
file-census)  exec python3 -m bbx.file_census "$@" ;;
readout)      exec python3 -m bbx.readout "$@" ;;
check-skills) exec python3 -m bbx.checkskills "$@" ;;
skill-guide)  exec python3 -m bbx.gen_skill_guide "$@" ;;
reanchors)    exec python3 -m bbx.reanchors "$@" ;;
skill-gen)    exec python3 -m bbx.gen_skill "$@" ;;
defaults)     exec python3 -m bbx.defaults "$@" ;;
documents)    exec python3 -m bbx.documents "$@" ;;
demand-after-trap) exec python3 -m bbx.demand_after_trap "$@" ;;
gate-index)   exec python3 -m bbx.gen_gate_index "$@" ;;
compare)      _t="${1:?bbx compare <flicker|window|composite|diverge|propose> ...}"; shift; case "$_t" in flicker|window|composite|exact|set|schema|band) exec python3 -m "bbx.compare_$_t" "$@" ;; diverge) exec python3 -m bbx.check_diverge "$@" ;; propose) exec python3 -m bbx.propose_temporal "$@" ;; *) echo "bbx compare: unknown class tool '$_t'" >&2; exit 2 ;; esac ;;
selftest)     cd "$BBX_HOME" && exec "$BBX_HOME/bin/bbx-run-static" --config "$BBX_HOME/bbx.toml" "$@" ;;
-h|--help|help) sed -n '2,27p' "$0"; exit 0 ;;
*) echo "bbx: unknown command '$cmd' (try bbx help)" >&2; exit 2 ;;
esac
